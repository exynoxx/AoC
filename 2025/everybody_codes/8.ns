numbers = (read:"input8.txt").nums {_ - 1}

# pt1
N = 32
half = N/2
println: #(numbers.pairwise [(_1 + half) % N = _2])

# pt2
segments = numbers.pairwise {((min: _1, _2), max: _1, _2)}
cross (a,b) (c,d) = (a < c & c < b & b < d) | (c < a & a < d & d < b)
println: segments {x=_; #(segments [cross: _, x])}/+ / 2

# pt3 
N = 256
half = N/2
cross2 p q = p = q | cross: p, q
println: max: N{i=_; (i+1)..N{(i,_)}}.flatten {x=_; #(segments [cross2: _, x])}