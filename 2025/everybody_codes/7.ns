names = sort: read/","; read
rules = lines {a, b = _ / " > "; (a,set: b/",")}.map ?? %[]

check name = name.pairwise {rules@_1 @? _2}/&

# pt1
println: names [check]

# pt2
println: names {(@,_.check)} [_2] {_1+1} /+

# pt3
f c n = (n > 11) ? 0 : (n >= 7).int + rules@c {f: _, (n+1)}/+
println: names [check] [s=_; #names[s.starts:_]<2] {f: _@-1,#_}/+


