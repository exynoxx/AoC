circle l = [(1,1,1)] ++ l [@%2=0] ++ (l [@%2=1] {(_2,_1,_3)}).rev
f c k i = { (a,b,n) = c@i; k < n ? a + (a > b ? -k : k) : f: c, k-n, i+1 }
solve file t = { c = circle: file.lines {nums} {(_1,_@-1,_@-1-_1+1)}; f: c, t % c{_3}/+, 0 }

println: solve: "input13a.txt", 2025
println: solve: "input13b.txt", 20252025
println: solve: "input13c.txt", 202520252025
