bone numbers = {
    M = [->]; L = [->]; R = [->]
    f x i = ?{
        !M @? i              => M@i = _
        x < M@i & !L @? i    => L@i = _
        x > M@i & !R @? i    => R@i = _
        _                    => f: x, i+1
    }
    numbers[@] {f: _, 0}
    (M,L,R)
}

quality tup = tup._1.keys.sort {str: tup._1@_} .join.int
l = lines {nums}

# pt1
println: quality: bone: l@0

# pt2
bones = l {bone}
qs = bones {quality}
println: qs.max - qs.min

# pt3
amor (M,L,R) lvl = [ L@lvl ?? -1, M@lvl ?? -1, R@lvl ?? -1 ][>0] {str}.join.int
maxlen (M1,_,_) (M2,_,_) = max: #M1.keys, #M2.keys
cmpamor i1 i2 k maxx = {
    r1 = amor: bones@i1, k
    r2 = amor: bones@i2, k
    ?{
        k>maxx          => i1 > i2
        r1 = r2         => cmpamor: i1, i2, k+1, maxx
        _               => r1 > r2 
    }
}

cmp = {(qs@_1 != qs@_2) ? qs@_1 > qs@_2 : (maxx = maxlen: bones@_1, bones@_2; cmpamor: _1, _2, 0, maxx)}

sorted = 0..qs.sort: cmp
println: (zip: sorted {+1}, 1.. #qs+1 ) {_1*_2} /+

