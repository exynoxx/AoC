bone numbers = {
    M = [->]; L = [->]; R = [->]
    f x i = ?{
        !M @? i              => M@i = _
        x < M@i & !L @? i    => L@i = _
        x > M@i & !R @? i    => R@i = _
        _                    => f: x, i+1
    }
    numbers[@] {f: _, 0}
    (M,L,R)
}

quality tup = tup._1.keys.sort {str: tup._1@_} .join.int
l = lines {nums}

# pt1
println: quality: bone: l@0

# pt2
bones = l {bone}
qs = bones {quality}
println: qs.max - qs.min

# pt3
amor (M,L,R) k = [L,M,R]{_@k ?? 0}[>0].join.int # bone and lvl => horizontal amor
levels b = b._1.keys.sort{amor: b, _}           # bone => all amor as list
lv = bones{levels}                              # lookup. bone 1 -> amor levels
sorted = (0..#qs).sort:{(qs@_1, lv@_1, _1) > (qs@_2, lv@_2, _2)} # lv@1 and lv@2 is list comparison
println: sorted{(_+1)*(@+1)}/+
