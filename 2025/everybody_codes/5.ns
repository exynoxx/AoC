# pt2
quality numbers = {
    M = [->]; L = %[]; R = %[]
    f x i = ?{
        !M @? i              => M@i = _
        x < M@i & !L @? i    => L+=i
        x > M@i & !R @? i    => R+=i
        _                    => f: x, i+1
    }
    numbers[@] {f: _, 0}
    M.keys.sort {str: M@_} .join.int
}

qualities = lines {nums} {quality}
println: qualities.max - qualities.min