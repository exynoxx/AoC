unpack "{a}:{b}" = (a,b/",")

bfs m = { q = Q["NULL"]; #q%{q ++= m@_}-1 }

# pt1
println: bfs: "6a.txt".lines {unpack}.map ?? []

# pt2
r = [->] ?? []; "6b.txt".lines {unpack} {a,b = _; b{r@_ ++= a}}
println: bfs: r

# pt3
g = "6c.txt".lines{unpack}.map ?? []
println: #g.keys[q = Q[_]; #q%{q ++= g@_; _}[_.starts: "NULL"] > 1]
