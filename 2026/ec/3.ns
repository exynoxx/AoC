f num i s = {
    lazy h i s = ((i<0) | s<=0) ? [(s=0,[0]**0)] : 10{d=_; (h: i-1, s-d*num@%i^^i)[_1]{(_1, [d]++_2)}}.flatten
    r := (h: num, i, s)[_1]{_2}.take1; (r = []) | (r@0 = num)
}

